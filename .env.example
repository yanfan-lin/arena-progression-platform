# Docker Compose reads .env for the MySQL container (env_file: .env).
# The Spring Boot apps do NOT read .env. When running from IntelliJ,
# mirror these values in Run Configuration > Environment variables so the app and the
# MySQL container always agree on credentials.

# Variables used by the MySQL container (Compose)
MYSQL_DATABASE=arena
MYSQL_USER=arena
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Variables used by the Spring Boot applications (application.yml)
MYSQL_URL=jdbc:mysql://localhost:3306/arena
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=progression-platform
REDIS_HOST=localhost
REDIS_PORT=6379
PROGRESSION_SERVER_PORT=8081
SIMULATOR_SERVER_PORT=8082
